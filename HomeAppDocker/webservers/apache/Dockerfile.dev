# Dev: app code is mounted from ../app by docker-compose.yml, Xdebug is enabled.
FROM homeapp-php-base

RUN install-php-extensions xdebug \
    && rm -f /usr/local/etc/php/conf.d/docker-php-ext-xdebug.ini
COPY ./webservers/apache/conf.d/xdebug.ini /usr/local/etc/php/conf.d/xdebug.ini

COPY ./webservers/apache/sites-enabled/site.conf /etc/apache2/sites-available/000-default.conf

COPY ./webservers/apache/docker-entrypoint.sh /usr/bin/docker-entrypoint
RUN chmod +x /usr/bin/docker-entrypoint \
    && a2enmod rewrite ssl remoteip \
    && mkdir -p /var/www/html/tests/test-files \
    && chown www-data /var/www/html/assets/images/profile-pics /var/www/html/tests/test-files

ENTRYPOINT ["docker-entrypoint", "-D", "FOREGROUND"]
